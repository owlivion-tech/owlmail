# ============================================================================
# Owlivion Mail - Environment Variables Example
# ============================================================================
#
# Copy this file to .env and fill in your OAuth2 credentials
# See OAUTH_SETUP.md for detailed instructions on how to get these credentials
#

# Google OAuth2 Credentials
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Microsoft OAuth2 Credentials
# Get from: https://portal.azure.com/
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ----------------------------------------------------------------------------
# Self-hosted Home Server (features relocated off the cloud for security)
# ----------------------------------------------------------------------------
# All URLs below default to the home server when unset (see
# src/config/homeServer.ts). Override them here to point elsewhere.

# Base host of the home server (used to derive the defaults below).
# VITE_HOME_SERVER_HOST=100.88.12.69

# Account Sync backend (owlivion-sync-server). Default: http://<host>:3300
# VITE_SYNC_SERVER_URL=http://100.88.12.69:3300

# Home AI bridge — Ollama-compatible endpoint backed by Claude Code.
# Default: http://<host>:11500  (see owlivion-home-ai/)
# VITE_HOME_AI_URL=http://100.88.12.69:11500

# Bearer token for the Home AI bridge (set AUTH_TOKEN on the bridge too).
# Generate once with: openssl rand -hex 32
# VITE_HOME_AI_TOKEN=your-secret-token-here

# Optional: Gemini API Key — only needed if you switch the AI provider back to
# Gemini in Settings. AI now defaults to the self-hosted home bridge.
# Get from: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key

# Build Variant: 'public' (default) or 'private' (enables OSINT, Spoof, etc.)
# VITE_BUILD_VARIANT=public

# ============================================================================
# IMPORTANT: Never commit the .env file to Git!
# The .env file should be in .gitignore
# ============================================================================
